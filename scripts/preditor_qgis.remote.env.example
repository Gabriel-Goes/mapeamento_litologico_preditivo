# Copie para scripts/preditor_qgis.remote.env no servidor.
# Este arquivo e opcional e voltado para execucao remota do QGIS.

# Ativar diagnostico antes de abrir o QGIS:
PREDITOR_REMOTE_DIAG=1

# Logging (arquivo principal + nível)
PREDITOR_TERRA_LOG_LEVEL=DEBUG
PREDITOR_TERRA_LOG_DIR=/home/ggrl/projetos/PreditorTerra-terraX/logs

# Perfil limpo e isolado do QGIS (recomendado para demo/apresentacao)
PREDITOR_PROFILE_NAME=PreditorTerraClean
PREDITOR_PROFILES_PATH=/home/ggrl/projetos/PreditorTerra-terraX/.qgis_profiles
PREDITOR_SESSION_LOG_DIR=/home/ggrl/projetos/PreditorTerra-terraX/logs/sessions

# Ajustes graficos remotos (geralmente bons defaults)
QT_QPA_PLATFORM=xcb
QT_X11_NO_MITSHM=1
LIBGL_ALWAYS_SOFTWARE=1
MESA_GL_VERSION_OVERRIDE=3.3
XDG_SESSION_TYPE=x11
GDK_BACKEND=x11

# Backend e banco
PREDITOR_DATA_BACKEND=postgres
PREDITOR_PG_HOST=127.0.0.1
PREDITOR_PG_PORT=5432
PREDITOR_PG_DB=geologia
PREDITOR_PG_USER=postgres
PREDITOR_PG_PASS=postgres
PREDITOR_PG_GAMA_SOURCE=geof.v_gamma_1082_corr

# Opcional: caminho extra de site-packages para habilitar STAC no Python do QGIS
# (ex.: pacote pystac_client/planetary_computer/rioxarray).
# PREDITOR_EXTRA_PYTHONPATH=/caminho/python3.14/site-packages
