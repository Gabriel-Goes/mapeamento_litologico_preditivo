# Copie para scripts/preditor_qgis.env e ajuste conforme o seu ambiente.

# Executavel do QGIS
QGIS_BIN=qgis

# Backend de dados
PREDITOR_DATA_BACKEND=postgres

# Conexao PostgreSQL/PostGIS
PREDITOR_PG_HOST=127.0.0.1
PREDITOR_PG_PORT=5432
PREDITOR_PG_DB=geologia
PREDITOR_PG_USER=postgres
PREDITOR_PG_PASS=
PREDITOR_PG_GAMA_SOURCE=geof.v_gamma_1082_corr
PREDITOR_PG_MAG_SOURCE=
PREDITOR_PG_CONNECT_TIMEOUT=8
PREDITOR_TERRA_CODE_FILE=/home/ggrl/projetos/PreditorTerra-terraX/codes/PreditoTerra_QGIS.py

# Opcional: paths Python adicionais (separados por ':')
# PREDITOR_EXTRA_PYTHONPATH=/caminho/site-packages:/outro/caminho

# Opcional: anexa site-packages de pyenv SOMENTE se a versao major.minor
# do Python do env for igual ao Python do QGIS.
# PREDITOR_PYENV_ENV=geo-qgis314
